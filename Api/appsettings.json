{
  "ConnectionStrings": {
    // The SQL Server Express instance visible in SSMS (HP_WORKSTATION).
    // Development used a LocalDB file before; AmsDb now lives on Express.
    "Default": "Server=HP_WORKSTATION\\SQLEXPRESS;Database=AmsDb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "ams-dev-jwt-key-change-me-before-any-production-use-0aa",
